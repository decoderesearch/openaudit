  "findings": [
    {
      "text": "InternLM3 claims state-of-the-art reasoning and knowledge performance versus Llama3.1-8B and Qwen2.5-7B while training on only 4 trillion tokens.", "tone": "neutral",
      "source": {
        "page": "Introduction",
        "quote": "State-of-the-art performance on reasoning and knowledge-intensive tasks surpass models like Llama3.1-8B and Qwen2.5-7B."
      }
    },
    {
      "text": "The card supports both deep thinking (long chain-of-thought) and a normal response mode.", "tone": "neutral",
      "source": {
        "page": "Introduction",
        "quote": "InternLM3 supports both the deep thinking mode for solving complicated reasoning tasks via the long chain-of-thought and the normal response mode for fluent user interactions."
      }
    },
    {
      "text": "MATH-500 and AIME2024 scores marked with * were evaluated with Thinking Mode.", "tone": "neutral",
      "source": {
        "page": "Performance Evaluation",
        "quote": "some data marked with *, which means evaluating with Thinking Mode"
      }
    },
    {
      "text": "OpenCompass version iteration may change reported evaluation numbers.", "tone": "neutral",
      "source": {
        "page": "Performance Evaluation",
        "quote": "The evaluation data may have numerical differences due to the version iteration of OpenCompass, so please refer to the latest evaluation results of OpenCompass."
      }
    },
    {
      "text": "Authors say they worked on safety in training but disclaim responsibility for harmful outputs that may still occur.", "tone": "mixed",
      "source": {
        "page": "Limitations",
        "quote": "Although we have made efforts to ensure the safety of the model during the training process and to encourage the model to generate text that complies with ethical and legal requirements, the model may still produce unexpected outputs due to its size and probabilistic generation paradigm."
      }
    }
  ],
