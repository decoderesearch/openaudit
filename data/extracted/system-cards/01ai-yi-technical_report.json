  "testers": [],
  "findings": [
    {
      "text": "01.AI describes a full-stack Responsible AI Safety Engine (RAISE) for safe pretraining, alignment, and deployment.", "tone": "neutral",
      "source": {
        "page": "9",
        "pdfPage": 9,
        "quote": "To enhance the model’s trustworthiness and safety, we develop a full-stack Responsible AI Safety\nEngine (RAISE)."
      }
    },
    {
      "text": "Pretraining uses heuristic, keyword, and classifier filters to remove Personal Identifiable Information (PII) and reduce sexual, violent, and extremist content.", "tone": "neutral",
      "source": {
        "page": "9",
        "pdfPage": 9,
        "quote": "we build\na set of filters based on heuristic rules, keyword matching, and learned classifiers to remove text\ncontaining personal identifiers and private data, and reduce sexual, violent, and extremist content."
      }
    },
    {
      "text": "A learned Safety Scorer removes toxic web documents such as violence, pornography, and political propaganda from pretraining data.", "tone": "neutral",
      "source": {
        "page": "5",
        "pdfPage": 5,
        "quote": "the Safety Scorer identifies and removes web documents containing\ntoxic content, such as violence, pornography, and political propaganda."
      }
    },
    {
      "text": "Alignment mixes a multi-category safety taxonomy dataset and attack-scenario prompts into dialog supervised fine-tuning (SFT) data.", "tone": "neutral",
      "source": {
        "page": "9",
        "pdfPage": 9,
        "quote": "We curated datasets reflecting these\ncategories for a robust alignment, and mix them with our dialog SFT data."
      }
    },
    {
      "text": "The authors built an internal helpful-and-harmless chat eval but report only external preference leaderboards, not those helpful and harmless (HH) scores.", "tone": "mixed",
      "source": {
        "page": "12",
        "pdfPage": 12,
        "quote": "we have established our own helpful and harmless evaluation dataset by gathering\nand constructing data of varying difficulty levels"
      }
    }
  ],
