  "findings": [
    {
      "text": "Automated safety scores are deltas vs Gemini 3.6 Flash and are not comparable to prior Gemini model cards due to improved evaluations.",
      "tone": "mixed",
      "source": {
        "page": "Training and Development Evaluation Results",
        "pdfPage": 7,
        "quote": "The performance results reported below are computed with improved evaluations and thus are not directly comparable with performance results found in previous Gemini model cards."
      }
    },
    {
      "text": "Manual review found automated safety losses were mostly false positives or not egregious.",
      "tone": "good",
      "source": {
        "page": "Training and Development Evaluation Results",
        "pdfPage": 7,
        "quote": "Our manual review confirmed losses were overwhelmingly either a) false positives or b) not egregious."
      }
    },
    {
      "text": "Child safety red-team evaluations met Google’s required launch thresholds.",
      "tone": "good",
      "source": {
        "page": "Human Red Teaming Results",
        "pdfPage": 7,
        "quote": "For child safety evaluations, Gemini 3.7 Flash satisfied required launch thresholds"
      }
    },
    {
      "text": "Red teaming versus Gemini 3.1 Pro found no egregious concerns outside strict policies.",
      "tone": "good",
      "source": {
        "page": "Human Red Teaming Results",
        "pdfPage": 8,
        "quote": "compared performance to Gemini 3.1 Pro, and found no egregious concerns."
      }
    },
    {
      "text": "Frontier Safety Framework (FSF) assessment found no tracked or critical capability levels reached; chemical, biological, radiological, and nuclear (CBRN) and cyber alert thresholds were reached for Level 1 critical capability levels (CCLs).",
      "tone": "mixed",
      "source": {
        "page": "Frontier Safety Assessment",
        "pdfPage": 8,
        "quote": "found that it did not reach any tracked or critical capability levels as outlined in the table below"
      }
    },
    {
      "text": "Model ships with updated CBRN and cyber offense misuse safeguards.",
      "tone": "good",
      "source": {
        "page": "Frontier Safety Assessment",
        "pdfPage": 9,
        "quote": "Gemini 3.7 Flash is shipping with updated safeguards to prevent misuse in the domains of Chemical, Biological, Radiological, and Nuclear (CBRN) and cyber offense."
      }
    },
    {
      "text": "Knowledge cutoff is March 2026, with some domains limited to January 2025.",
      "tone": "neutral",
      "source": {
        "page": "Known Limitations",
        "pdfPage": 6,
        "quote": "The knowledge cutoff date for Gemini 3.7 Flash is March 2026 – users can expect updated information for some domains while in others they may experience the model’s knowledge is limited to January 2025"
      }
    },
    {
      "text": "[Image to Text Safety](/evals/gdm-image-to-text-safety) showed no change versus Gemini 3.6 Flash on automated evaluations.",
      "tone": "good",
      "source": {
        "page": "Training and Development Evaluation Results",
        "pdfPage": 6,
        "quote": "Image to Text Safety | Automated content safety evaluation measuring safety policies | No change Lower is better"
      }
    }
  ],
