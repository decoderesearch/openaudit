  "findings": [
    {
      "text": "reinforcement learning from AI feedback (RLAIF-V) preference learning is used to reduce object hallucination without sacrificing OpenCompass score.", "tone": "good",
      "source": {
        "page": "15",
        "pdfPage": 15,
        "quote": "RLAIF-V effectively\nreduces the hallucination rates of the base model on both response level and mention level."
      }
    },
    {
      "text": "MiniCPM-V 2.0 uses reinforcement learning from human feedback (RLHF-V) for alignment; MiniCPM-Llama3-V 2.5 uses RLAIF-V; MiniCPM-V 1.0 has no alignment stage.", "tone": "neutral",
      "source": {
        "page": "13",
        "pdfPage": 13,
        "quote": "MiniCPM-V 2.0                MiniCPM 2B             1.8M pixel (e.g., 1344 × 1344)        Any      stage-1&2&3    part1+2    RLHF-V"
      }
    },
    {
      "text": "The authors present qualitative cases claiming fewer hallucinations than GPT-4V on detailed image descriptions.", "tone": "good",
      "source": {
        "page": "16",
        "pdfPage": 16,
        "quote": "fewer hallucinations as compared with powerful GPT-4V, showing its promising reliability and"
      }
    }
  ],
