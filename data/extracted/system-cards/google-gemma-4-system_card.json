  "disclosures": {
    "releaseDate": {
      "status": "not_stated"
    },
    "knowledgeCutoff": {
      "status": "stated",
      "value": "January 2025",
      "source": {
        "page": "Model Data > Training Dataset",
        "quote": "which includes web\ndocuments, code, images, audio, with a cutoff date of January 2025"
      }
    },
    "contextWindow": {
      "status": "stated",
      "value": "128K tokens (E2B/E4B) and 256K tokens (12B/26B A4B/31B)",
      "source": {
        "page": "Core Capabilities",
        "quote": "Context windows of up to 128K tokens (E2B/E4B) and 256K\ntokens (12B/26B A4B/31B)."
      }
    },
    "maxOutput": {
      "status": "not_stated"
    },
    "modalities": {
      "status": "stated",
      "value": "Text and image input (audio on E2B, E4B, and 12B); text output; video via frame sequences",
      "source": {
        "page": "Introduction",
        "quote": "Gemma 4 models are\nmultimodal, handling text and image input (with audio supported on E2B, E4B, and 12B models)\nand generating text output."
      }
    },
    "reasoningModes": {
      "status": "stated",
      "value": "configurable thinking modes; enable with <|think|> in system prompt",
      "source": {
        "page": "Introduction",
        "quote": "All models in the family are designed as highly capable\nreasoners, with configurable thinking modes."
      }
    },
    "languages": {
      "status": "stated",
      "value": "Out-of-the-box support for 35+ languages, pre-trained on 140+ languages",
      "source": {
        "page": "Core Capabilities",
        "quote": "Out-of-the-box support for 35+ languages, pre-trained on\n140+ languages."
      }
    },
    "license": {
      "status": "stated",
      "value": "Apache 2.0",
      "source": {
        "page": "Header",
        "quote": "License: Apache 2.0 | Authors: Google DeepMind"
      }
    },
    "totalParams": {
      "status": "stated",
      "value": "E2B 2.3B effective (5.1B with embeddings); E4B 4.5B effective (8B with embeddings); 12B 11.95B; 26B A4B 25.2B; 31B 30.7B",
      "source": {
        "page": "Models Overview > Dense Models / MoE Model",
        "quote": "Total Parameters\n 2.3B effective (5.1B with embeddings)\n 4.5B effective (8B with embeddings)\n 11.95B\n 30.7B"
      }
    },
    "activeParams": {
      "status": "stated",
      "value": "26B A4B MoE: 3.8B active (8 active / 128 total experts and 1 shared)",
      "source": {
        "page": "Mixture-of-Experts (MoE) Model",
        "quote": "Active Parameters\n 3.8B"
      }
    },
    "architecture": {
      "status": "stated",
      "value": "Dense and Mixture-of-Experts (MoE); hybrid local sliding-window and global attention with p-RoPE; 12B Unified encoder-free",
      "source": {
        "page": "Introduction / Models Overview",
        "quote": "Featuring both Dense and Mixture-of-Experts (MoE) architectures, Gemma 4 is\nwell-suited for tasks like text generation, coding, and reasoning."
      }
    },
    "trainingData": {
      "status": "stated",
      "value": "Web documents, code, mathematics, images, audio; over 140 languages; CSAM and sensitive-data filtering",
      "source": {
        "page": "Model Data > Training Dataset",
        "quote": "Our pre-training dataset is a large-scale, diverse collection of data\nencompassing a wide range of domains and modalities, which includes web\ndocuments, code, images, audio, with a cutoff date of January 2025."
      }
    },
    "trainingCompute": {
      "status": "not_stated"
    }
  },
