  "testers": [],
  "findings": [
    {
      "text": "Safety evals were run without safety filters; the card reports only qualitative 'minimal policy violations' with no numeric safety scores.", "tone": "mixed",
      "source": {
        "page": "Ethics and Safety > Evaluation Results",
        "quote": "All testing was conducted without safety\nfilters to evaluate the model capabilities and behaviors."
      }
    },
    {
      "text": "Google says Gemma 4 receives the same rigorous safety evaluations as proprietary Gemini models.", "tone": "neutral",
      "source": {
        "page": "Ethics and Safety",
        "quote": "Gemma 4 undergoes the same\nrigorous safety evaluations as our proprietary Gemini models."
      }
    },
    {
      "text": "Gemma 4 12B Unified drops dedicated multimodal encoders and projects image patches and audio waveforms directly into the large language model (LLM) embedding space.", "tone": "neutral",
      "source": {
        "page": "Models Overview > Dense Models",
        "quote": "Gemma 4 12B eliminates these encoders entirely,\nprojecting raw image patches and audio waveforms directly into the LLM's\nembedding space through lightweight linear layers."
      }
    },
    {
      "text": "E2B/E4B use Per-Layer Embeddings so effective parameter counts are much smaller than total embedding-inclusive counts.", "tone": "neutral",
      "source": {
        "page": "Models Overview > Dense Models",
        "quote": "The \"E\" in E2B and E4B stands for \"effective\" parameters. The smaller models\nincorporate Per-Layer Embeddings (PLE)"
      }
    },
    {
      "text": "Benchmark comparison baseline is Gemma 3 27B with thinking disabled (\"no think\").", "tone": "neutral",
      "source": {
        "page": "Benchmark Results",
        "quote": "Gemma 3 27B (no think)"
      }
    },
    {
      "text": "Audio is capped at 30 seconds and video at 60 seconds at 1 fps; audio supported only on E2B, E4B, and 12B.", "tone": "neutral",
      "source": {
        "page": "Best Practices > Audio and Video Length",
        "quote": "Audio supports a maximum\nlength of 30 seconds. Video supports a maximum of 60 seconds assuming the images\nare processed at one frame per second."
      }
    }
  ],
