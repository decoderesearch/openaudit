  "findings": [
    {
      "text": "Safety deltas use improved internal evals and are not directly comparable to prior Gemini model cards.",
      "tone": "mixed",
      "source": {
        "page": "Training and Development Evaluation Results",
        "pdfPage": 6,
        "quote": "The performance results reported below are computed with improved evaluations and thus are not directly comparable with performance results found in previous Gemini model cards."
      }
    },
    {
      "text": "Manual review found automated safety losses were mostly false positives or not egregious.",
      "tone": "good",
      "source": {
        "page": "Training and Development Evaluation Results",
        "pdfPage": 6,
        "quote": "Our manual review confirmed losses were overwhelmingly either a) false positives or b) not egregious."
      }
    },
    {
      "text": "[Tone](/evals/gdm-tone) slightly regressed versus Gemini 3.5 Flash without changing overall safety judgment.",
      "tone": "mixed",
      "source": {
        "page": "Training and Development Evaluation Results",
        "pdfPage": 6,
        "quote": "Flash 3.6 saw slight regressions in tone, however this does not impact the overall safety of the model."
      }
    },
    {
      "text": "Child safety red-team evaluations met Google’s required launch thresholds.",
      "tone": "good",
      "source": {
        "page": "Human Red Teaming Results",
        "pdfPage": 7,
        "quote": "For child safety evaluations, Gemini 3.6 Flash satisfied required launch thresholds"
      }
    },
    {
      "text": "Red teaming versus Gemini 3.1 Pro found no egregious concerns outside strict policies.",
      "tone": "good",
      "source": {
        "page": "Human Red Teaming Results",
        "pdfPage": 7,
        "quote": "compared performance to Gemini 3.1 Pro, and found no egregious concerns."
      }
    },
    {
      "text": "Frontier Safety Framework (FSF) assessment treats 3.6 Flash as unlikely to reach any Critical Capability Levels (CCLs), based on Gemini 3.1 Pro results.",
      "tone": "good",
      "source": {
        "page": "Frontier Safety Assessment",
        "pdfPage": 7,
        "quote": "based on Gemini 3.1 Pro results, we are confident that Gemini 3.6 Flash is also unlikely to reach any CCLs."
      }
    },
    {
      "text": "Prior Gemini 3 models reached the cyber alert threshold; additional testing found 3.6 Flash still below the cyber Critical Capability Level (CCL).",
      "tone": "good",
      "source": {
        "page": "Frontier Safety Assessment",
        "pdfPage": 7,
        "quote": "As previous models in the Gemini 3 series reached the alert threshold for cyber, we performed additional testing in this domain and found that Gemini 3.6 Flash remains below the cyber CCL."
      }
    },
    {
      "text": "Knowledge cutoff is March 2026, with some domains limited to January 2025.",
      "tone": "neutral",
      "source": {
        "page": "Known Limitations",
        "pdfPage": 5,
        "quote": "The knowledge cutoff date for Gemini 3.6 Flash is March 2026 – users can expect updated information for some domains while in others they may experience the model’s knowledge is limited to January 2025"
      }
    }
  ],
