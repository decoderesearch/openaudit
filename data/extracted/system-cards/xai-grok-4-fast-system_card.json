  "findings": [
    {
      "text": "All evaluations in this report used a near-final release checkpoint.", "tone": "neutral",
      "source": {
        "page": "1",
        "pdfPage": 1,
        "quote": "All evaluations in this report were conducted on a near-final\nrelease checkpoint."
      }
    },
    {
      "text": "Deployed system prompt does not include explicit honesty instructions; adding them drops [MASK](/evals/mask) dishonesty to 0.21 (reasoning) and 0.54 (non-reasoning).", "tone": "mixed",
      "source": {
        "page": "4",
        "pdfPage": 4,
        "quote": "For Grok 4 Fast, our deployed system prompt does not include explicit instructions to avoid\ndeceptive behavior."
      }
    },
    {
      "text": "Dual-use capability evaluations remove safeguards; high scores mean more weapons-development capability, not necessarily higher residual risk.", "tone": "neutral",
      "source": {
        "page": "5",
        "pdfPage": 5,
        "quote": "We remove safeguards when assessing dual-use capabilities."
      }
    },
    {
      "text": "Non-reasoning mode increases dishonesty by a noticeable margin versus reasoning mode.", "tone": "bad",
      "source": {
        "page": "4",
        "pdfPage": 4,
        "quote": "evaluating the model in non-reasoning mode increases the rate of dishonesty by a noticeable margin."
      }
    },
    {
      "text": "Narrow topical input filters remain deployed against chemical and biological weapons-related abuse.", "tone": "good",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "Our narrow, topically-focused filters remain deployed across all product surfaces as an additional\nsafeguard against chemical and biological weapons-related abuse."
      }
    },
    {
      "text": "System prompts for consumer products are published publicly on GitHub.", "tone": "neutral",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "We publish system prompts for our consumer products at: https://github.com/xai-org/grok-\nprompts."
      }
    },
    {
      "text": "The card notes a typo-like reference to training “Grok 4 Code” to obey additional system/user instructions that do not violate policy.", "tone": "neutral",
      "source": {
        "page": "2",
        "pdfPage": 2,
        "quote": "We train Grok 4 Code to obey additional instructions in\nsystem or user messages, as long as they do not violate the policy message."
      }
    }
  ],
