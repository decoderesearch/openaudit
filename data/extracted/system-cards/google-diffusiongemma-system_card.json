    "architecture": {
      "status": "stated",
      "value": "26B A4B MoE Gemma 4 encoder-decoder with discrete text diffusion; 8 active / 128 total experts and 1 shared; canvas length 256",
      "source": {
        "page": "Introduction",
        "quote": "Based on the 26B A4B Mixture-of-Experts (MoE) Gemma 4 architecture, DiffusionGemma generates tokens using discrete diffusion."
      }
    },
