  "testers": [],
  "findings": [
    {
      "text": "Safety evals were run without safety filters; the card reports only qualitative 'minimal policy violations' with no numeric safety scores.", "tone": "mixed",
      "source": {
        "page": "Ethics and Safety > Evaluation Results",
        "quote": "All testing was intentionally conducted without safety filters to evaluate the model's raw capabilities and baseline behaviors."
      }
    },
    {
      "text": "Google says DiffusionGemma receives the same rigorous safety evaluations as proprietary Gemini models.", "tone": "neutral",
      "source": {
        "page": "Ethics and Safety",
        "quote": "DiffusionGemma undergoes the same rigorous safety evaluations as our proprietary Gemini models."
      }
    },
    {
      "text": "On HLE without tools, DiffusionGemma scores higher than the Gemma 4 26B A4B baseline (11.0% vs 8.7%).", "tone": "neutral",
      "source": {
        "page": "Benchmark Results",
        "quote": "HLE no tools\t11.0%\t8.7%"
      }
    },
    {
      "text": "Discrete diffusion generates 15-20 tokens per forward pass and claims over 1100 tokens/sec on H100 FP8 at low batch size.", "tone": "neutral",
      "source": {
        "page": "Core Capabilities",
        "quote": "generating 15-20 tokens per forward pass, unlocking per user generation speeds exceeding 1100 tokens per second in low batch size settings (H100, FP8)."
      }
    },
    {
      "text": "Video is processed as frame sequences with a maximum of 60 seconds at one frame per second.", "tone": "neutral",
      "source": {
        "page": "Best Practices > Video Length",
        "quote": "Video supports a maximum of 60 seconds assuming the images are processed at one frame per second."
      }
    }
  ],
