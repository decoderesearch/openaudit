  "findings": [
    {
      "text": "Grok 4 API and Web exceed human expert baselines on [BioLP-Bench](/evals/biolp-bench) (38.4%) and [VCT](/evals/vct) (22.1%), described as superhuman on biological protocols and wetlab virology.", "tone": "bad",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "human expert performance on BioLP-Bench is\n38.4% and 22.1% on VCT, so both Grok 4 API and Grok 4 Web achieve superhuman performance"
      }
    },
    {
      "text": "Dual-use capability evaluations remove safeguards; high scores indicate greater weapons-development capability, not necessarily higher residual risk.", "tone": "neutral",
      "source": {
        "page": "5",
        "pdfPage": 5,
        "quote": "We remove safeguards when assessing dual-use capabilities."
      }
    },
    {
      "text": "Radiological and nuclear capabilities were not evaluated; the lab expects models not to meaningfully improve those weapons paths under existing controls.", "tone": "mixed",
      "source": {
        "page": "2",
        "pdfPage": 2,
        "quote": "We do not evaluate radiological or nuclear capabilities."
      }
    },
    {
      "text": "Third-party testing finds end-to-end offensive cyber capabilities remain below a human professional despite a large step up in general cyber knowledge.", "tone": "mixed",
      "source": {
        "page": "2",
        "pdfPage": 2,
        "quote": "third-party testing shows that Grok 4’s end-to-end\noffensive cyber capabilities remain below the level of a human professional."
      }
    },
    {
      "text": "A deployed system prompt adds mitigations beyond safety training for many undesirable behaviors assessed in the report.", "tone": "good",
      "source": {
        "page": "2",
        "pdfPage": 2,
        "quote": "on top of our safety training, we have implemented a system prompt that provides\nadditional mitigations for many of the undesirable behaviors we assess in this report."
      }
    },
    {
      "text": "Narrow topical input filters are deployed against bioweapons- and chemical weapons-related abuse across product surfaces.", "tone": "good",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "we have deployed narrow, topically-focused\nfilters across all product surfaces as an additional safeguard against bioweapons-related abuse."
      }
    },
    {
      "text": "Consumer product system prompts are published publicly on GitHub.", "tone": "neutral",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "We publish system prompts for our consumer products at: https://github.com/xai-org/grok-\nprompts."
      }
    },
    {
      "text": "Grok 4 Web does not accept custom system prompts, so system-jailbreak evaluations are not reported for Web.", "tone": "mixed",
      "source": {
        "page": "2",
        "pdfPage": 2,
        "quote": "Grok 4 Web does not accept custom system prompts from users, so we do not evaluate with\nsystem jailbreaks."
      }
    }
  ],
