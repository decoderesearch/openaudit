  "testers": [],
  "findings": [
    {
      "text": "None of Aya-101, Aya-23-8B, or Aya-23-35B had targeted multilingual safety alignment beyond incidental safety examples from Command R+ synthetics.", "tone": "bad",
      "source": {
        "page": "13",
        "pdfPage": 13,
        "quote": "none of the three models have undergone any targeted safety alignment\nin the multilingual fine-tuning stage beyond learning from incidental safety examples in synthetically\ngenerated examples from Command R+."
      }
    },
    {
      "text": "Versus Aya-101-13B, Aya 23 harmful-response rates on [Multilingual AdvBench](https://arxiv.org/abs/2307.15043) fell for all six languages and by at least half on average.", "tone": "good",
      "source": {
        "page": "13",
        "pdfPage": 13,
        "quote": "we find that the rate of harmful responses is lower for all languages, and on average reduced\nby at least half."
      }
    },
    {
      "text": "On English identity prompts, Aya 23 models show slightly higher toxicity than Aya-101 except they are less toxic for Asians and Latinx and more toxic for Blacks and Whites, especially women.", "tone": "mixed",
      "source": {
        "page": "14",
        "pdfPage": 14,
        "quote": "This holds true for all languages except English, where the toxicity is slightly\nhigher for the new Aya 23 models."
      }
    },
    {
      "text": "[AdvBench](/evals/advbench) scores are framed as remaining alignment needed for those cases, not as proof the models are already aligned.", "tone": "neutral",
      "source": {
        "page": "13",
        "pdfPage": 13,
        "quote": "These scores therefore reflect how much alignment would\nstill be needed for the specific safety cases captured in AdvBench, rather than how much they are\nalready aligned."
      }
    }
  ],
