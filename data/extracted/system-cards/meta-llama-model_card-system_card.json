  "findings": [
    {
      "text": "The model was not trained with human feedback and can generate toxic, offensive, incorrect, or unhelpful content.", "tone": "bad",
      "source": {
        "page": "Intended use",
        "quote": "our model has not been trained with human feedback, and can thus generate toxic or offensive content, incorrect information or generally unhelpful answers."
      }
    },
    {
      "text": "Performance is expected to be better for English than for other languages, though 20 languages appear in training data.", "tone": "neutral",
      "source": {
        "page": "Factors",
        "quote": "most of our dataset is made of English text, and we thus expect the model to perform better for English than other languages."
      }
    },
    {
      "text": "Only one model of each size was trained, so pre-training variability was not evaluated.", "tone": "neutral",
      "source": {
        "page": "Metrics",
        "quote": "we trained only one model of each size, and thus could not evaluate variability of pre-training."
      }
    },
    {
      "text": "Web training data was filtered by proximity to Wikipedia text using a Kneser-Ney language model (LM) and a fastText classifier.", "tone": "neutral",
      "source": {
        "page": "Ethical considerations",
        "quote": "We filtered the data from the Web based on its proximity to Wikipedia text and references."
      }
    },
    {
      "text": "As a foundational model, LLaMA should not be used in downstream apps without further risk investigation and mitigation.", "tone": "mixed",
      "source": {
        "page": "Ethical considerations",
        "quote": "LLaMA is a foundational model, and as such, it should not be used for downstream applications without further investigation and mitigations of risks."
      }
    }
  ],
