  "findings": [
    {
      "text": "On external benchmarks, SG-9B reports 10.8% higher average area under the precision-recall curve (AU-PRC) than LlamaGuard1 with similar size and training data volume.", "tone": "good",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "SG-9B achieves a 10.8% higher average"
      }
    },
    {
      "text": "SG-9B F1 exceeds [WildGuard](https://arxiv.org/abs/2406.18495) by 4.3% and GPT-4 by 6.4% on the reported comparison.", "tone": "good",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "4.3% and 6.4%, respectively."
      }
    },
    {
      "text": "On external benchmarks, 9B/27B average AU-PRC is 1.2%/1.7% higher than the 2B model.", "tone": "good",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "ing on average a 1.2%/1.7% higher AU-PRC than"
      }
    },
    {
      "text": "In zero-shot use, GPT-4 confuses harm types: 76% of hate-speech points were classified positive for harassment.", "tone": "neutral",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "For example 76%"
      }
    },
    {
      "text": "Authors advise scoring mode only (Yes/No token scores), not chat use, because the model can produce unethical or unsafe content without safety instruction-tuning.", "tone": "mixed",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "it solely for generating Yes/No token scores"
      }
    },
    {
      "text": "While trained on six harms, reported performance is only for four targeted harms (hate, dangerous, sexual, harassment).", "tone": "mixed",
      "source": {
        "page": "5",
        "pdfPage": 5,
        "quote": "we report performance only on the four"
      }
    },
    {
      "text": "Fairness counterfactual expansion still leaves possible label discrepancies when identity groups are swapped, linked to pre-training bias.", "tone": "mixed",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "Fairness: While we have implemented fairness"
      }
    },
    {
      "text": "Figure 3 (harm-type AU-PRC charts) has no readable numeric values in the text layer; numbers were not extracted.", "tone": "mixed",
      "source": {
        "page": "8",
        "pdfPage": 8,
        "quote": "Figure 3 | Harm Type level performance (AU-PRC) for our test dataset SG Prompt (left) and SG"
      }
    }
  ],
