  "findings": [
    {
      "text": "Llama-2-Chat models are on par with ChatGPT and PaLM on human evaluations for helpfulness and safety.", "tone": "good",
      "source": {
        "quote": "in our human evaluations for helpfulness and safety, are on par with some popular closed-source models like ChatGPT and PaLM",
        "page": "Model Details"
      }
    },
    {
      "text": "Testing so far has been in English only and cannot cover all scenarios.", "tone": "mixed",
      "source": {
        "quote": "Testing conducted to date has been in English, and has not covered, nor could it cover all scenarios.",
        "page": "Ethical Considerations and Limitations"
      }
    },
    {
      "text": "Pretraining used 3.3M GPU hours on A100-80GB with estimated emissions of 539 tCO2eq, fully offset by Meta.", "tone": "neutral",
      "source": {
        "quote": "Pretraining utilized a cumulative 3.3M GPU hours of computation on hardware of type A100-80GB (TDP of 350-400W). Estimated total emissions were 539 tCO2eq, 100% of which were offset by Meta’s sustainability program.",
        "page": "Hardware and Software"
      }
    },
    {
      "text": "Neither pretraining nor fine-tuning datasets include Meta user data.", "tone": "good",
      "source": {
        "quote": "Neither the pretraining nor the fine-tuning datasets include Meta user data.",
        "page": "Training Data"
      }
    },
    {
      "text": "The model is static and trained on an offline dataset; future tuned versions may follow community safety feedback.", "tone": "mixed",
      "source": {
        "quote": "This is a static model trained on an offline dataset. Future versions of the tuned models will be released as we improve model safety with community feedback.",
        "page": "Model Details"
      }
    }
  ],
