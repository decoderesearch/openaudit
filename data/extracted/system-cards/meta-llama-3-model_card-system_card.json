    "totalParams": {
      "status": "stated",
      "value": "8B and 70B",
      "source": {
        "page": "Model Details",
        "quote": "Llama 3 comes in two sizes — 8B and 70B parameters — in pre-trained and instruction tuned variants."
      }
    },
    "activeParams": {
      "status": "not_stated"
    },
    "architecture": {
      "status": "stated",
      "value": "auto-regressive optimized transformer with GQA; SFT and RLHF for tuned versions",
      "source": {
        "page": "Model Details",
        "quote": "Llama 3 is an auto-regressive language model that uses an optimized transformer architecture. Llama 3 uses a tokenizer with a vocabulary of 128K tokens, and was trained on on sequences of 8,192 tokens. Grouped-Query Attention (GQA) is used for all models"
      }
    },
    "trainingData": {
      "status": "stated",
      "value": "over 15 trillion tokens from publicly available sources; fine-tuning includes public instruction datasets and over 10M human-annotated examples",
      "source": {
        "page": "Training Data",
        "quote": "Llama 3 was pretrained on over 15 trillion tokens of data from publicly available sources. The fine-tuning data includes publicly available instruction datasets, as well as over 10M human-annotated examples."
      }
    },
    "trainingCompute": {
      "status": "stated",
      "value": "7.7M GPU hours on H100-80GB",
      "source": {
        "page": "Hardware and Software",
        "quote": "Pretraining utilized a cumulative** 7.7M GPU hours of computation on hardware of type H100-80GB (TDP of 700W)."
      }
    }
  },
