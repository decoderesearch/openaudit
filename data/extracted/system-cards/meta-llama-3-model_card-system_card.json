  "findings": [
    {
      "text": "Testing to date has been in English only and cannot cover all scenarios.", "tone": "mixed",
      "source": {
        "page": "Ethical Considerations and Limitations",
        "quote": "Testing conducted to date has been in English, and has not covered, nor could it cover, all scenarios."
      }
    },
    {
      "text": "Meta says residual risks will likely remain for any large language model, including Llama 3.", "tone": "mixed",
      "source": {
        "page": "Responsibility & Safety",
        "quote": "As with any Large Language Model, residual risks will likely remain and we recommend that developers assess these risks in the context of their use case."
      }
    },
    {
      "text": "Llama 3 is described as significantly less likely to falsely refuse benign prompts than Llama 2.", "tone": "good",
      "source": {
        "page": "Responsibility & Safety",
        "quote": "Llama 3 is significantly less likely to falsely refuse to answer prompts than Llama 2."
      }
    },
    {
      "text": "On [CyberSecEval](https://arxiv.org/abs/2312.04724) insecure coding and attacker helpfulness tests, Llama 3 was in the same range or safer than models of equivalent coding capability.", "tone": "good",
      "source": {
        "page": "Cyber Security",
        "quote": "Llama 3 behaved in the same range or safer than models of equivalent coding capability"
      }
    },
    {
      "text": "CBRNE safety included an external expert uplift test compared with what web search alone can achieve.", "tone": "neutral",
      "source": {
        "page": "Critical risks",
        "quote": "by reference to what can be achieved using web search (without the model)."
      }
    },
    {
      "text": "Pretraining used 7.7M H100 GPU hours with estimated emissions of 2290 tCO2eq, stated as 100% offset by Meta.", "tone": "neutral",
      "source": {
        "page": "Hardware and Software",
        "quote": "Estimated total emissions were 2290 tCO2eq, 100% of which were offset by Meta’s sustainability program."
      }
    },
    {
      "text": "Neither pretraining nor fine-tuning datasets include Meta user data.", "tone": "good",
      "source": {
        "page": "Training Data",
        "quote": "Neither the pretraining nor the fine-tuning datasets include Meta user data."
      }
    },
    {
      "text": "The release is a static model trained on an offline dataset; future tuned versions may follow community safety feedback.", "tone": "mixed",
      "source": {
        "page": "Model Details",
        "quote": "This is a static model trained on an offline dataset. Future versions of the tuned models will be released as we improve model safety with community feedback."
      }
    }
