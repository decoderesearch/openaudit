    {
      "text": "Ethics and safety results are reported only as within acceptable internal-policy thresholds; no numeric violation rates are given for child safety, content safety, memorization, or chemical, biological, radiological, and nuclear (CBRN).", "tone": "good",
      "source": {
        "page": "Ethics and Safety > Evaluation Results",
        "quote": "The results of ethics and safety evaluations are within acceptable thresholds for meeting internal policies for categories such as child safety, content safety, representational harms, memorization, large-scale harms."
      }
    },
    {
      "text": "Dangerous-capability numbers are given only for Gemma 2 instruction-tuned (IT) 27B; smaller IT sizes are omitted from that table.", "tone": "mixed",
      "source": {
        "page": "Dangerous Capability Evaluations > Evaluation Results",
        "quote": "Evaluation\tCapability\tGemma 2 IT 27B"
      }
    },
    {
      "text": "Benchmark capability table reports pre-trained (PT) variants; safety table reports instruction-tuned (IT) variants.", "tone": "neutral",
      "source": {
        "page": "Evaluation > Benchmark Results",
        "quote": "Benchmark\tMetric\tGemma 2 PT 2B\tGemma 2 PT 9B\tGemma 2 PT 27B"
      }
    },
    {
      "text": "Training used TPUv5p with JAX and ML Pathways; no floating-point operations (FLOPs) or training-compute figure is stated.", "tone": "neutral",
      "source": {
        "page": "Implementation Information > Hardware",
        "quote": "Gemma was trained using the latest generation of Tensor Processing Unit (TPU) hardware (TPUv5p)."
      }
    },
