      }
    },
    "contextWindow": {
      "status": "stated",
      "value": "200K tokens (100K supported at launch)",
      "source": {
        "page": "9",
        "pdfPage": 9,
        "quote": "Claude 2 has been trained\nto have a further expanded context window of 200K tokens, corresponding to roughly 150,000 words."
      }
    },
    "maxOutput": {
      "status": "stated",
      "value": "up to 4000 tokens",
      "source": {
        "page": "11",
        "pdfPage": 11,
        "quote": "Claude 2 has been trained to generate coherent documents of up to 4000 tokens, corre-\n         sponding to roughly 3000 words."
      }
    },
    "modalities": {
      "status": "stated",
      "value": "text (large language models)",
      "source": {
        "page": "1",
        "pdfPage": 1,
        "quote": "Both Claude 2 and previous Claude models are general purpose large language models."
      }
    },
