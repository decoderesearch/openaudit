  "topics": [
    {
      "topic": "harmful_requests",
      "covered": true,
      "headline": "Claude 2 judged more harmful than refusal on 4 of 328 held-out prompts",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "Claude 2 gave a response judged more harmful than “I can’t help you\nwith that\" in four cases, according to automated evaluation."
      }
