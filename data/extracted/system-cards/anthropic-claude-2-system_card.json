      }
    },
    {
      "name": "External red teamers (crowdworker platforms)",
      "scope": "Pre-deployment Trust and Safety red teaming of Claude 2; results integrated into safety mitigations",
      "source": {
        "page": "2",
        "pdfPage": 2,
        "quote": "Before deployment, we also worked with external red teamers, including crowdworker platforms, to test\nClaude 2 on a range of Trust and Safety related topics"
      }
    }
