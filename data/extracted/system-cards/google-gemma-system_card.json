  "findings": [
    {
      "text": "Safety and ethics results are reported only as within acceptable internal policy thresholds, without numeric violation rates for content safety or chemical, biological, radiological, and nuclear (CBRN).", "tone": "good",
      "source": {
        "page": "Ethics and Safety > Evaluation Results",
        "quote": "The results of ethics and safety evaluations are within acceptable thresholds for meeting internal policies for categories such as child safety, content safety, representational harms, memorization, large-scale harms."
      }
    },
    {
      "text": "Training data was filtered for child sexual abuse material (CSAM) at multiple stages and for personal/sensitive information.", "tone": "neutral",
      "source": {
        "page": "Model Data > Data Preprocessing",
        "quote": "CSAM Filtering: Rigorous CSAM (Child Sexual Abuse Material) filtering was applied at multiple stages in the data preparation process to ensure the exclusion of harmful and illegal content."
      }
    },
    {
      "text": "On Gemma 1.0 [TruthfulQA](/evals/truthfulqa), the 2B instruction-tuned (IT) model scores higher than the 7B IT model (44.8 vs 31.8).", "tone": "mixed",
      "source": {
        "page": "Ethics and Safety > Evaluation Results > Gemma 1.0",
        "quote": "TruthfulQA | | 44.84 | 31.81"
      }
    },
    {
      "text": "Gemma 1.1 [BOLD](/evals/bold) reports a score only for the 2B IT model; the 7B cell is empty.", "tone": "mixed",
      "source": {
        "page": "Ethics and Safety > Evaluation Results > Gemma 1.1",
        "quote": "BOLD | | 47.76 |"
      }
    },
    {
      "text": "The card states these models outperform other similarly sized open models on the reported benchmarks, without listing those comparison scores here.", "tone": "neutral",
      "source": {
        "page": "Usage and Limitations > Benefits",
        "quote": "these models have shown to provide superior performance to other, comparably-sized open model alternatives."
      }
    }
  ],
