  "findings": [
    {
      "text": "Llama Guard 3-1B-INT4 matches or beats Llama Guard 3-1B on safety moderation while being about 7× smaller (440MB).", "tone": "good",
      "source": {
        "page": "1",
        "pdfPage": 1,
        "quote": "safety moderation scores to its larger counterpart, Llama Guard 3-1B, despite being approximately 7"
      }
    },
    {
      "text": "Distillation from Llama Guard 3-8B improved absolute F1 by 1.3% on the internal test set versus standard finetuning.", "tone": "good",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "We observed a 1.3 percent (absolute) improvement in F1-score on internal"
      }
    },
    {
      "text": "On a Moto-Razor Android phone the INT4 model reached at least 30 tokens/s and at most 2.5s time-to-first-token.", "tone": "neutral",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "to a Moto-Razor phone and observed >= 30 token/s and <=2.5s time-to-first-token."
      }
    },
    {
      "text": "Authors warn some hazard categories (Defamation, Intellectual Property, Elections) need up-to-date factual knowledge beyond this baseline.", "tone": "mixed",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "Some hazard categories may require factual, up-to-date knowledge to be evaluated (for example, S5:"
      }
    },
    {
      "text": "Unembedding pruning keeps 20 output tokens, cutting the output layer from 262.6M to 41.0k parameters.", "tone": "neutral",
      "source": {
        "page": "5",
        "pdfPage": 5,
        "quote": "we reduced the output layer size from 262.6M parameters (2048 × 128k) to 40.96k parameters"
      }
    }
  ],
