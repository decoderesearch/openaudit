  "findings": [
    {
      "text": "On VLM-as-a-Judge safety, Granite Vision scores comparably to larger baselines while being the lightest model in the comparison.", "tone": "good",
      "source": {
        "page": "15",
        "pdfPage": 15,
        "quote": "Granite Vision performs comparably to other baselines on\nthe standard safety evaluation setup"
      }
    },
    {
      "text": "Adding Safety Vectors to Granite Vision markedly improves safety classification accuracy on reformulated [VLGuard](/evals/vlguard) and MHalu tasks.", "tone": "good",
      "source": {
        "page": "16",
        "pdfPage": 16,
        "quote": "addition of Safety\nVectors to Granite Vision leads to a significant improvement in safety classification performance"
      }
    },
    {
      "text": "Training data was filtered for legal/personally identifiable information (PII) issues, child sexual abuse material (CSAM) via NSFW detectors, and face blurring for visual PII.", "tone": "good",
      "source": {
        "page": "9",
        "pdfPage": 9,
        "quote": "Sexual Abuse Material (CSAM) removal: All CSAM was removed from the datasets using state-of-"
      }
    },
    {
      "text": "Authors plan to scale Safety Vectors with more training data because few-shot samples may not cover the full range of safety issues.", "tone": "mixed",
      "source": {
        "page": "16",
        "pdfPage": 16,
        "quote": "Current reliance\nfor SVs is on few-shot samples which are informative but may have limited scope in terms of capturing the\nrange of possible safety issues"
      }
    }
  ],
