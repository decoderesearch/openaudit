  "testers": [],
  "findings": [
    {
      "text": "SG2 average precision-recall AUC (PR-AUC) is 89.1% on the internal benchmark, beating Gemma-3-4B-IT, GPT-4o mini, and LlavaGuard 7B by 6.8%, 12.9%, and 14.8%.", "tone": "good",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "erage PR-AUC of 89.1%. This represents improve-"
      }
    },
    {
      "text": "Training without BADG drops F1 by 2.6% on danger and 2.7% on violence.", "tone": "neutral",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "a 2.6%/2.7% drop in F1 score for danger and violence, respectively."
      }
    },
    {
      "text": "GPT-4o mini has very high recall on the internal benchmark but over-triggers, which lowers precision.", "tone": "neutral",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "GPT-4o mini exhibits a very high recall; however, it suffers\nsignificantly from over-triggering, resulting in a much lower precision."
      }
    },
    {
      "text": "On [UnsafeBench](https://arxiv.org/abs/2405.03486) danger after relabeling, SG2 reaches 100% recall versus 80% for GPT-4o mini and Gemma 3.", "tone": "good",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "fect (100%) recall compared to 80% for the other"
      }
    },
    {
      "text": "Direct Yes/No prediction without thresholding cuts SG2 F1 by a marginal 0.8%.", "tone": "neutral",
      "source": {
        "page": "6",
        "pdfPage": 6,
        "quote": "marginal 0.8% reduction F1 score for SG2."
      }
    },
    {
      "text": "The detector does not handle harm that comes from text overlays on otherwise benign images.", "tone": "mixed",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "beyond the scope of our detector\nfor this specific challenge of evaluating unsafe"
      }
    },
    {
      "text": "The model is limited to single-image classification and does not process interleaved text-image conversations.", "tone": "mixed",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "not designed for, and therefore beyond the\nscope of this work, to process interleaved se-"
      }
    },
    {
      "text": "SG2 is not specifically fine-tuned for policies beyond sexual, danger, and violence.", "tone": "mixed",
      "source": {
        "page": "7",
        "pdfPage": 7,
        "quote": "not specifically fine-tuned for policies other than\nsexual, danger and violence."
      }
    }
  ],
