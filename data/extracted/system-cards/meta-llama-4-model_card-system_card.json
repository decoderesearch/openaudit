  "findings": [
    {
      "text": "Meta followed a three-pronged safeguards strategy: enable safe developer use, protect against adversarial users, and protect the community from misuse.", "tone": "good",
      "source": {
        "page": "Safeguards",
        "quote": "As part of our release approach, we followed a three-pronged strategy to manage risks:"
      }
    },
    {
      "text": "Safety fine-tuning emphasized reducing refusals to benign prompts and removing preachy or moralizing refusal tone.", "tone": "good",
      "source": {
        "page": "Safeguards",
        "quote": "we put a great emphasis on driving down model refusals to benign prompts for Llama 4"
      }
    },
    {
      "text": "Meta recommends deploying Llama 4 with system protections such as Llama Guard, Prompt Guard, and Code Shield rather than in isolation.", "tone": "mixed",
      "source": {
        "page": "Safeguards",
        "quote": "We provide the community with system level [protections](https://llama.meta.com/trust-and-safety/) \\- like Llama Guard, Prompt Guard and Code Shield"
      }
    },
    {
      "text": "Chemical, biological, radiological, nuclear, and explosive (CBRNE) helpfulness was assessed with expert-designed evaluations and additional red teaming for content-policy violations; no numeric threshold or final risk tier is stated.", "tone": "mixed",
      "source": {
        "page": "Critical Risks",
        "quote": "To assess risks related to proliferation of chemical and biological weapons for Llama 4, we applied expert-designed and other targeted evaluations"
      }
    },
    {
      "text": "Child Safety mitigation includes pre-training data filtering, expert post-training assessment, expanded multi-image and multi-lingual benchmarks, and further fine-tuning and red teaming.", "tone": "good",
      "source": {
        "page": "Critical Risks",
        "quote": "We leverage pre-training methods like data filtering as a first step in mitigating Child Safety risk in our model."
      }
    },
    {
      "text": "Cyber evaluations focused on automating cyberattacks, exploiting vulnerabilities, and automating harmful workflows; Meta concludes catastrophic cyber enablement risk is not introduced.", "tone": "good",
      "source": {
        "page": "Critical Risks",
        "quote": "Specifically, we focused on evaluating the capabilities of Llama 4 to automate cyberattacks, identify and exploit security vulnerabilities, and automate harmful workflows."
      }
    },
    {
      "text": "Image understanding was tested up to 5 input images; developers must mitigate and test beyond that.", "tone": "mixed",
      "source": {
        "page": "Intended Use",
        "quote": "Llama 4 has been tested for image understanding up to 5 input images."
      }
    },
    {
      "text": "Reported benchmarks used bf16 weights even though quantized checkpoints are provided for deployment.", "tone": "neutral",
      "source": {
        "page": "Benchmarks",
        "quote": "We've provided quantized checkpoints for deployment flexibility, but all reported evaluations and testing were conducted on bf16 models."
      }
    },
    {
      "text": "The card states testing to date has not covered all scenarios and outputs can be inaccurate or objectionable.", "tone": "mixed",
      "source": {
        "page": "Considerations and Limitations",
        "quote": "Testing conducted to date has not covered, nor could it cover, all scenarios."
      }
    },
    {
      "text": "Training used 7.4M GPU hours with estimated 1,999 tons CO2eq location-based emissions and 0 tons market-based.", "tone": "neutral",
      "source": {
        "page": "Hardware and Software",
        "quote": "Estimated total location-based greenhouse gas emissions were **1,999 tons** CO2eq for training."
      }
    }
  ],
