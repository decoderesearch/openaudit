  "findings": [
    {
      "text": "About 10% of in-house red-teaming cases failed, which authors attribute to helpfulness tuning that sometimes yields inappropriate answers.", "tone": "bad",
      "source": {
        "page": "10",
        "pdfPage": 10,
        "quote": "About 10% of the test cases failed, likely because EXAONE 3.0 7.8B is tuned to increase the helpfulness of its responses,"
      }
    },
    {
      "text": "On the Korean trustworthiness benchmark, authors say the model is somewhat effective at filtering harmful reactions but still has much room for improvement.", "tone": "mixed",
      "source": {
        "page": "11",
        "pdfPage": 11,
        "quote": "The experimental result shows that the model is somewhat effective at filtering out\nharmful reactions, but there is still much room for improvement. Please refer to Table 17 for an example."
      }
    },
    {
      "text": "Despite filtering personal, harmful, and biased training data, the authors warn inappropriate or biased answers may still be generated.", "tone": "mixed",
      "source": {
        "page": "13",
        "pdfPage": 13,
        "quote": "Inappropriate answers may be generated, which contain personal, harmful or other inappropriate information."
      }
    },
    {
      "text": "An AI Ethical Impact Assessment identified risks including malicious misuse, discriminatory bias, and harmful content.", "tone": "good",
      "source": {
        "page": "9",
        "pdfPage": 9,
        "quote": "Through AI Ethical Impact Assessment, we identified several risks and improved the model’s safety."
      }
    },
    {
      "text": "LG AI Research says it conducts AI Compliance reviews across data collection, model training, and information provision.", "tone": "good",
      "source": {
        "page": "5",
        "pdfPage": 5,
        "quote": "To minimize these risks, LG AI Research conducts AI Compliance reviews throughout the entire process of data"
      }
    }
  ],
