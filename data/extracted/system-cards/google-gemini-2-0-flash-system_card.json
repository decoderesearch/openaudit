  "findings": [
    {
      "text": "Safety and tone scores are relative to Gemini 1.5 Pro 002: lower Text/Multilingual safety percentages mean fewer violations; [Tone](/evals/gdm-tone) +1.5% means better refusal tone.", "tone": "neutral",
      "source": {
        "page": "5",
        "pdfPage": 6,
        "quote": "For safety evaluations, a decrease in percentage represents\na reduction in violation rates compared to Gemini 1.5 Pro 002, while for tone, a positive\npercentage increase is representative of an improvement in the tone of model refusal\ncompared to Gemini 1.5 Pro 002."
      }
    },
    {
      "text": "Gemini 2.0 family had lower content-policy violation rates than Gemini 1.5 Pro in most modalities, with a small regression on image-to-text.", "tone": "mixed",
      "source": {
        "page": "5",
        "pdfPage": 6,
        "quote": "displaying lower violation rates in\nmost modalities than Gemini 1.5 Pro"
      }
    },
    {
      "text": "The model sometimes refuses safe prompts (e.g. “Do I sound Italian?”); refusals can still sound preachy though tone improved vs Gemini 1.5.", "tone": "mixed",
      "source": {
        "page": "5",
        "pdfPage": 6,
        "quote": "The model will sometimes refuse to answer on prompts where an answer would not\nviolate policies (e.g. “Do I sound Italian?”)."
      }
    },
    {
      "text": "Image outputs were experimental as of the model card publish date.", "tone": "neutral",
      "source": {
        "page": "1",
        "pdfPage": 2,
        "quote": "Image outputs are experimental as of the publishing\ndate of this model card."
      }
    },
    {
      "text": "Frontier Safety Framework evaluations were listed among pre-release activities, but this card reports no Critical Capability Level (CCL) or critical-capability outcomes.", "tone": "mixed",
      "source": {
        "page": "4",
        "pdfPage": 5,
        "quote": "Frontier Safety Framework evaluations according to Google DeepMind’s Frontier\n      Safety Framework (FSF)"
      }
    },
    {
      "text": "Instruction Following safety eval was reported as tied (“=”) with Gemini 1.5 Pro 002, so no numeric evalResult was recorded.", "tone": "neutral",
      "source": {
        "page": "5",
        "pdfPage": 6,
        "quote": "Instruction Following model’s ability to follow instructions                    ="
      }
    }
  ],
