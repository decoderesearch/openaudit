{
  "eval": {
    "slug": "instrumentaleval",
    "displayName": "InstrumentalEval",
    "aliases": ["Instrumental Eval", "Evaluating the Paperclip Maximizer"],
    "description": "Tests propensity for instrumental convergence in single-turn agent prompts: shutdown evasion, unauthorized system access, self-replication, hiding behavior, strategic appearance of alignment, and deception. 76 hand-crafted scenarios across six categories. A separate grader LLM labels each response convergence or no_convergence; the headline metric is the convergence rate.",
    "summary": "Measures how often AI agents show instrumental goals, such as avoiding shutdown, gaining access, copying themselves, or deceiving people.",
    "maintainers": [
      {
        "name": "Yufei He et al.",
        "url": "https://github.com/yf-he/InstrumentalEval"
      }
    ],
    "links": [
      {
        "kind": "paper",
        "url": "https://arxiv.org/abs/2502.12206",
        "title": "Evaluating the Paperclip Maximizer: Are RL-Based Language Models More Likely to Pursue Instrumental Goals?"
      },
      {
        "kind": "repo",
        "url": "https://github.com/yf-he/InstrumentalEval",
        "title": "Official benchmark CSVs and code"
      }
    ],
    "access": "public",
    "status": "active",
    "autoApprove": true,
    "facets": {
      "measures": ["propensity"],
      "formats": ["single_turn"],
      "cases": ["fixed"],
      "grading": ["model_judge"],
      "adversarial": false,
      "humanParticipants": false,
      "subjects": ["model"],
      "topics": ["power_seeking", "honesty"]
    },
    "visibility": "public"
  },
