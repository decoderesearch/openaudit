{
  "eval": {
    "slug": "salad-bench",
    "displayName": "SALAD-Bench",
    "aliases": ["SALAD Bench", "SALADBench"],
    "description": "Hierarchical LLM safety benchmark with 21,318 base harmful questions across 6 domains, 16 tasks, and 66 categories, plus attack-enhanced (5,000), defense-enhanced (200), and MCQ (3,840) subsets. MD-Judge labels QA responses safe or unsafe; the headline metric is safety rate (ASR = 1 − safety rate on attack or defense subsets).",
    "summary": "Measures how safely the model answers harmful questions, including when attack prompts try to break its safety rules.",
    "maintainers": [
      {
        "name": "OpenSafetyLab",
        "url": "https://github.com/OpenSafetyLab/SALAD-BENCH"
      }
    ],
    "links": [
      {
        "kind": "paper",
        "url": "https://arxiv.org/abs/2402.05044",
        "title": "SALAD-Bench: A Hierarchical and Comprehensive Safety Benchmark for Large Language Models"
      },
      {
        "kind": "repo",
        "url": "https://github.com/OpenSafetyLab/SALAD-BENCH",
        "title": "SALAD-Bench and MD-Judge"
      },
      {
        "kind": "dataset",
        "url": "https://huggingface.co/datasets/OpenSafetyLab/Salad-Data",
        "title": "OpenSafetyLab/Salad-Data"
      }
    ],
    "access": "public",
    "status": "active",
    "facets": {
      "measures": ["propensity", "robustness"],
      "formats": ["single_turn"],
      "cases": ["fixed"],
      "grading": ["model_judge", "programmatic"],
      "adversarial": true,
      "humanParticipants": false,
      "subjects": ["model"],
      "topics": ["harmful_requests", "jailbreaks"]
    },
    "visibility": "public"
  },
  "versions": [
