        "hfRepo": "ArtificialAnalysis/AA-Omniscience-Public",
        "revision": "e4883edbb9f5ccf2b2a8fdc6fb65e01a58e99849",
        "url": "https://huggingface.co/datasets/ArtificialAnalysis/AA-Omniscience-Public",
