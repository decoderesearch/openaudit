      }
    ],
    "access": "public",
    "status": "active",
    "facets": {
      "measures": ["capability"],
      "formats": ["single_turn"],
      "cases": ["fixed"],
      "grading": ["model_judge"],
      "adversarial": false,
      "humanParticipants": false,
      "subjects": ["model"],
      "topics": ["hallucination"]
    },
    "visibility": "public"
  },
  "versions": [
    {
      "version": "2024-12",
      "status": "published",
      "releasedDate": "2024-12-17",
      "dataset": {
        "hfRepo": "google/FACTS-grounding-public",
        "revision": "11b6961370aa0ac73c91d58e35317e724b2ac765",
        "url": "https://huggingface.co/datasets/google/FACTS-grounding-public",
