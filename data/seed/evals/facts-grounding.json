{
  "eval": {
    "slug": "facts-grounding",
    "displayName": "FACTS Grounding",
    "aliases": ["FACTS Grounding Benchmark", "FACTS Grounding v1"],
    "description": "Tests whether long-form answers stay grounded in a given document. Each example has a system instruction, a user request and a context document of up to about 32k tokens. An ensemble of model judges first marks answers that do not address the request as ineligible, then checks each eligible answer against the document. The score is the share of answers that are both eligible and grounded. The maintainers keep a private set for the Kaggle leaderboard.",
    "summary": "Tests whether the model writes long answers that use only facts from a given document.",
    "maintainers": [
      {
        "name": "Google DeepMind, Kaggle",
        "url": "https://www.kaggle.com/facts-leaderboard"
      }
    ],
    "links": [
      {
        "kind": "paper",
        "url": "https://arxiv.org/abs/2501.03200",
        "title": "The FACTS Grounding Leaderboard: Benchmarking LLMs' Ability to Ground Responses to Long-Form Input"
      },
      {
        "kind": "blog",
        "url": "https://deepmind.google/discover/blog/facts-grounding-a-new-benchmark-for-evaluating-the-factuality-of-large-language-models/",
        "title": "FACTS Grounding: A new benchmark for evaluating the factuality of large language models"
      },
      {
        "kind": "dataset",
        "url": "https://huggingface.co/datasets/google/FACTS-grounding-public",
        "title": "google/FACTS-grounding-public (860 public examples)"
      },
      {
