{
  "eval": {
    "slug": "wildguard-test",
    "displayName": "WildGuardTest",
    "aliases": ["WildGuard-Test", "WildGuardTest", "WildGuard Test"],
    "description": "Human-annotated moderation test set from AI2 WildGuardMix. It has 1,725 prompt-response pairs (vanilla and adversarial) labeled for prompt harm, response harm, and response refusal across 13 risk categories. Guard models are scored with F1 or accuracy on those labels; chat-model cards also report refusal or output-safety rates when WildGuard grades completions on the same prompts.",
    "summary": "Tests whether safety classifiers correctly detect harmful prompts, harmful responses, and refusals in normal and adversarial chats.",
    "family": "AI2 Safety Toolkit",
    "maintainers": [
      {
        "name": "Allen Institute for AI",
        "url": "https://github.com/allenai/wildguard"
      }
    ],
    "links": [
      {
        "kind": "paper",
        "url": "https://arxiv.org/abs/2406.18495",
        "title": "WildGuard: Open One-Stop Moderation Tools for Safety Risks, Jailbreaks, and Refusals of LLMs"
      },
      {
        "kind": "repo",
        "url": "https://github.com/allenai/wildguard",
        "title": "WildGuard model and evaluation code"
      },
      {
        "kind": "dataset",
        "url": "https://huggingface.co/datasets/allenai/wildguardmix",
        "title": "allenai/wildguardmix (WildGuardTrain + WildGuardTest)"
      }
    ],
    "access": "gated",
    "status": "active",
    "facets": {
      "measures": ["capability", "propensity", "robustness"],
      "formats": ["single_turn"],
      "cases": ["fixed"],
      "grading": ["programmatic", "model_judge"],
      "adversarial": true,
      "humanParticipants": false,
      "subjects": ["model"],
      "topics": ["harmful_requests", "jailbreaks", "toxicity"]
    },
    "visibility": "public"
  },
  "versions": [
    {
      "version": "2024-06-26",
