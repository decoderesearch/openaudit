+    path = write_jsonl(tmp_path / "r.jsonl", _rows([RH], text=_plan_text))
+    r = judge.run(sargs(path, items=[RH], extra={**DIRECT, judge.CTX_OPT: "once"}))
+    assert fj.n("digest") == 0 and len(ft.calls) == 1
+    user = ft.calls[0][0]
