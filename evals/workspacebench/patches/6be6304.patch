+        }
+        for it in items
+        for L in LAYERS
+    ]
+
+
+def _run(tmp_path, monkeypatch, client, answer, **extra):
+    items = _fixture_bank(tmp_path, monkeypatch, 2, 2)
+    jb0 = items[0]["id"]
+    path = write_jsonl(tmp_path / "r.jsonl", _cells(items, {jb0: 48, "ctl-1": 40}))
+    fake = client(lambda model, kw: _resp(json.dumps(answer(kw)), model=model))
+    res = jb_judge.run(_pinned_summary_args(path, tmp_path / "o", **DIRECT, **extra))
+    return res, fake, jb0
+
+
+def _user(kw) -> str:
+    c = kw["messages"][0]["content"]
+    return c if isinstance(c, str) else "".join(b["text"] for b in c)
+
+
+def test_split_parts():
+    lines = ["a" * 40, "b" * 40, "c" * 40, "d" * 400]
+    assert jb_judge.split_parts(lines, 22) == [(0, 2), (2, 3), (3, 4)]
+    assert jb_judge.split_parts(lines, 10_000) == [(0, 4)]
+    assert jb_judge.split_parts([], 10) == []
+
+
+def test_any_part():
+    assert jb_judge.any_part([False, True, None]) is True
+    assert jb_judge.any_part([False, None]) is None
+    assert jb_judge.any_part([False, False]) is False
+
+
+def test_chunked_parts_and_verdicts(tmp_path, monkeypatch, client):
+    res, fake, jb0 = _run(
+        tmp_path, monkeypatch, client, lambda kw: _item_answer(_user(kw)), item_chunk="1"
+    )
+    users = [_user(c) for c in fake.calls]
+    assert len(users) == 4 * len(LAYERS) * jb_prompts.N_DRAWS
+    assert all(" OF 3: " in u for u in users)
+    assert sum(jb_prompts.part_note(2, 3) in u for u in users) == 4 * jb_prompts.N_DRAWS
+    rows = {r["id"]: r for r in res.rows}
+    assert rows[jb0]["parts"] == 3 and rows[jb0]["part_hits"] == [False, False, True]
+    assert rows["ctl-1"]["part_hits"] == [True, False, False]
+    assert {i for i, r in rows.items() if r["any_recognition"]} == {jb0, "ctl-1"}
+    assert len(rows[jb0]["draws"]) == 3 * jb_prompts.N_DRAWS
+    assert res.config["prompt_version"].endswith("+chunk1")
+
+
+def test_quotes_verify_on_own_part(tmp_path, monkeypatch, client):
+    """A judge that answers yes quoting RECOG in every part: only the part holding it passes."""
+    yes = {"answer": "yes", "quotes": [RECOG], "rationale": ""}
+    res, _, jb0 = _run(tmp_path, monkeypatch, client, lambda kw: yes, item_chunk="1")
+    rows = {r["id"]: r for r in res.rows}
+    assert rows[jb0]["part_hits"] == [False, False, True]
+    assert rows["ctl-1"]["part_hits"] == [True, False, False]
+    assert not rows["ctl-0"]["any_recognition"]
+
+
+def test_unchunked_unchanged(tmp_path, monkeypatch, client):
+    res, fake, jb0 = _run(tmp_path, monkeypatch, client, lambda kw: _item_answer(_user(kw)))
+    assert len(fake.calls) == 4 * jb_prompts.N_DRAWS
+    assert not any("PART" in _user(c) for c in fake.calls)
+    rows = {r["id"]: r for r in res.rows}
+    assert "parts" not in rows[jb0]
+    assert {i for i, r in rows.items() if r["any_recognition"]} == {jb0, "ctl-1"}
+    assert "+chunk" not in res.config["prompt_version"]
+
+
+def test_chunk_needs_direct(tmp_path, monkeypatch):
+    items = _fixture_bank(tmp_path, monkeypatch, 2, 2)
+    path = write_jsonl(tmp_path / "r.jsonl", _cells(items, {}))
+    with pytest.raises(SystemExit):
+        jb_judge.run(_pinned_summary_args(path, tmp_path / "o", item_chunk="100"))
+    with pytest.raises(SystemExit):
+        jb_judge.run(_pinned_summary_args(path, tmp_path / "o", **DIRECT, item_chunk="x"))
