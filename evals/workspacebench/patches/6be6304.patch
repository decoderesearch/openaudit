+def combine_parts(raws: Sequence[str]) -> str:
+    """One Stage C reply from the replies of a split readout's parts: design_fidelity is the
+    highest over the parts (its best-matching candidate, as the rubric asks over the whole
+    readout); the PRIMARY PLAN is the part's plan that the most lines state (on a tie, the first
+    part); design_rank is 1 when the best-matching candidate is that primary plan, else null
+    (ranks 2 and 3 are not combined over parts)."""
+    parsed = [parse_design_score_summary(r) for r in raws]
+    lines = [int(m.group(1)) if (m := _PLAN_LINES.search(r)) else 0 for r in raws]
