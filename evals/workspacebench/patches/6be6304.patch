diff --git a/tests/test_llm_batch.py b/tests/test_llm_batch.py
new file mode 100644
index 0000000..e543569
--- /dev/null
+++ b/tests/test_llm_batch.py
@@ -0,0 +1,251 @@
+"""Offline tests for batch mode (``WSB_BATCH=1``): a fake Message Batches client."""
+
+import json
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+
+from wsbench import llm
+from wsbench.llm import schema_block, stream_json
+
+SCHEMA = schema_block("t", {"a": {"type": "integer"}}, ["a"])
+OPUS = "claude-opus-5-5"
+
+
+def _msg(text: str, stop: str = "end_turn", **usage: Any) -> Any:
+    u = {"input_tokens": 1000, "output_tokens": 100, "cache_read_input_tokens": 0}
+    u.update(usage)
+    return SimpleNamespace(
+        stop_reason=stop,
+        content=[SimpleNamespace(type="text", text=text)],
+        usage=SimpleNamespace(cache_creation_input_tokens=0, cache_creation=None, **u),
+    )
+
+
+def _ok(cid: str, msg: Any) -> Any:
+    return SimpleNamespace(custom_id=cid, result=SimpleNamespace(type="succeeded", message=msg))
+
+
+def _err(cid: str, etype: str, message: str = "") -> Any:
+    err = SimpleNamespace(error=SimpleNamespace(type=etype, message=message))
+    return SimpleNamespace(custom_id=cid, result=SimpleNamespace(type="errored", error=err))
+
+
+class _Results:
+    def __init__(self, rows: list[Any]):
+        self.rows = rows
+
+    def __aiter__(self):
+        async def gen():
+            for r in self.rows:
+                yield r
+
+        return gen()
+
+
+class FakeBatches:
+    """``rounds``: one function per batch, request list -> result entries."""
+
+    def __init__(self, rounds: list[Any]):
+        self.rounds = list(rounds)
+        self.sent: list[list[dict[str, Any]]] = []
+        self.out: dict[str, list[Any]] = {}
+        self.polls = 0
+        self.closed = False
+        self.messages = SimpleNamespace(
+            batches=SimpleNamespace(
+                create=self._create, retrieve=self._retrieve, results=self._results, cancel=None
+            )
+        )
+
+    def _batch(self, bid: str, status: str) -> Any:
+        n = len(self.out.get(bid, []))
+        counts = SimpleNamespace(succeeded=n, errored=0, expired=0, canceled=0)
+        return SimpleNamespace(id=bid, processing_status=status, request_counts=counts)
+
+    async def _create(self, requests: list[dict[str, Any]]) -> Any:
+        bid = f"b{len(self.sent)}"
+        self.sent.append(requests)
+        self.out[bid] = self.rounds.pop(0)(requests)
+        return self._batch(bid, "in_progress")
+
+    async def _retrieve(self, bid: str) -> Any:
+        self.polls += 1
+        return self._batch(bid, "ended")
+
+    async def _results(self, bid: str) -> Any:
+        return _Results(self.out[bid])
+
+    async def close(self) -> None:
+        self.closed = True
+
+
+@pytest.fixture
+def batch_env(monkeypatch):
+    monkeypatch.setenv("ANTHROPIC_API_KEY", "sk-ant-test")
+    monkeypatch.setenv(llm.BATCH_ENV, "1")
+    monkeypatch.delenv(llm.VIA_OPENROUTER_ENV, raising=False)
+
+    async def no_sleep(s: float) -> None:
+        return None
+
+    monkeypatch.setattr(llm, "_sleep", no_sleep)
+
+
+def _run(monkeypatch, fake: Any, prompts: list[tuple[str, str]], **kw: Any):
+    monkeypatch.setattr(llm, "_make_client", lambda route, key: fake)
+    got: dict[int, Any] = {}
+    spend = stream_json(
+        prompts, schema=SCHEMA, model=OPUS, on_result=lambda i, r: got.__setitem__(i, r), **kw
+    )
+    return got, spend
+
+
+def test_batch_success_retry_and_refusal(batch_env, monkeypatch, tmp_path):
+    ledger = tmp_path / "ledger.jsonl"
+    monkeypatch.setenv(llm.LEDGER_ENV, str(ledger))
+    first = lambda reqs: [  # noqa: E731
+        _ok("r0", _msg('{"a": 1}')),
+        _err("r1", "overloaded_error"),
+        _ok("r2", _msg("", stop="refusal")),
+        _err("r3", "invalid_request_error", "prompt is too long: 300000 tokens"),
+    ]
+    second = lambda reqs: [_ok("r1", _msg('{"a": 2}'))]  # noqa: E731
+    fake = FakeBatches([first, second])
+    got, spend = _run(monkeypatch, fake, [("s", f"u{i}") for i in range(4)])
+    assert got == {0: {"a": 1}, 1: {"a": 2}, 2: None, 3: None}
+    assert [len(s) for s in fake.sent] == [4, 1]
+    assert fake.sent[1][0]["custom_id"] == "r1"
+    params = fake.sent[0][0]["params"]
+    assert params["model"] == OPUS
+    assert params["output_config"]["effort"] == "low"
+    assert params["messages"][0]["content"] == "u0"  # no repeated prompts: no user cache mark
+    assert spend.refusals == 1 and spend.errors == 1 and spend.retries == 1
+    rows = [json.loads(line) for line in ledger.open()]
+    assert all(r["batch"] for r in rows)
+    # 1000 in x $4 + 100 out x $20 per million, halved
+    assert rows[0]["cost"] == pytest.approx((1000 * 4 + 100 * 20) / 1e6 / 2)
+    assert spend.usd == pytest.approx(sum(r["cost"] for r in rows))
+    assert fake.closed
+
+
+def test_batch_reasks_a_max_tokens_stop_once_with_the_overflow_cap(batch_env, monkeypatch):
+    first = lambda reqs: [  # noqa: E731
+        _ok("r0", _msg('{"a": 1}')),
+        _ok("r1", _msg('{"a": ', stop="max_tokens")),
+        _ok("r2", _msg('{"a": ', stop="max_tokens")),
+    ]
+    reask = lambda reqs: [  # noqa: E731
+        _ok("r0", _msg('{"a": 2}')),
+        _ok("r1", _msg('{"a": ', stop="max_tokens")),
+    ]
+    fake = FakeBatches([first, reask])
+    got, spend = _run(
+        monkeypatch, fake, [("s", f"u{i}") for i in range(3)], max_tokens=100,
+        overflow_max_tokens=200,
+    )  # fmt: skip
+    assert got == {0: {"a": 1}, 1: {"a": 2}, 2: None}
+    assert [r["params"]["max_tokens"] for r in fake.sent[1]] == [200, 200]
+    assert [r["params"]["messages"][0]["content"] for r in fake.sent[1]] == ["u1", "u2"]
+    assert spend.errors == 1  # only the second stop is a lost call
+
+    # with no overflow cap, a max_tokens stop is a lost call at once
+    fake = FakeBatches([lambda reqs: [_ok("r0", _msg('{"a": ', stop="max_tokens"))]])
+    got, spend = _run(monkeypatch, fake, [("s", "u0")], max_tokens=100)
+    assert got == {0: None} and len(fake.sent) == 1 and spend.errors == 1
+
+
+def test_batch_caches_repeated_user_turn_for_one_hour(batch_env, monkeypatch):
+    monkeypatch.setattr(llm, "cache_user_now", True)
+    fake = FakeBatches([lambda reqs: [_ok("r0", _msg('{"a": 1}'))]])
+    _run(monkeypatch, fake, [("s", "u")])
+    params = fake.sent[0][0]["params"]
+    one_hour = {"type": "ephemeral", "ttl": "1h"}
+    assert params["messages"][0]["content"][0]["cache_control"] == one_hour
+    assert params["system"][0]["cache_control"] == one_hour
+
+
+def test_cost_counts_cache_writes_and_hits():
+    u = SimpleNamespace(
+        input_tokens=0,
+        output_tokens=0,
+        cache_creation_input_tokens=3_000_000,
+        cache_creation=SimpleNamespace(ephemeral_1h_input_tokens=1_000_000),
+        cache_read_input_tokens=1_000_000,
+    )
+    # 2M x 5m write (1.25 x $4) + 1M x 1h write (2 x $4) + 1M hits (0.05 x $4)
+    assert llm.anthropic_cost(OPUS, u, batch=False) == pytest.approx(10 + 8 + 0.2)
+    assert llm.anthropic_cost(OPUS, u, batch=True) == pytest.approx((10 + 8 + 0.2) / 2)
+
+
+SONNET = "claude-sonnet-5"
+
+
+def _run_text(monkeypatch, fake: Any, prompts: list[str], **kw: Any):
+    monkeypatch.setattr(llm, "_make_client", lambda route, key: fake)
+    got: dict[int, Any] = {}
+    served: dict[int, str] = {}
+    spend = llm.stream_text(
+        prompts,
+        model=SONNET,
+        on_result=lambda i, r: got.__setitem__(i, r),
+        on_served=lambda i, m: served.__setitem__(i, m),
+        thinking=True,
+        max_tokens=1000,
+        **kw,
+    )
+    return got, served, spend
+
+
+def test_batch_text_retry_budget_doubling_and_refusal_model(batch_env, monkeypatch, tmp_path):
+    ledger = tmp_path / "ledger.jsonl"
+    monkeypatch.setenv(llm.LEDGER_ENV, str(ledger))
+    first = lambda reqs: [  # noqa: E731
+        _ok("r0", _msg("  hello ")),
+        _err("r1", "overloaded_error"),
+        _ok("r2", _msg("", stop="refusal")),
+        _ok("r3", _msg("", stop="max_tokens")),
+    ]
+    second = lambda reqs: [_ok("r1", _msg("again")), _ok("r3", _msg("long"))]  # noqa: E731
+    fallback = lambda reqs: [_ok("r0", _msg("served"))]  # noqa: E731
+    fake = FakeBatches([first, second, fallback])
+    got, served, spend = _run_text(
+        monkeypatch, fake, ["u0", "u1", "u2", "u3"], refusal_model="claude-opus-5"
+    )
+    assert got == {0: "hello", 1: "again", 2: "served", 3: "long"}
+    assert served == {2: "claude-opus-5"}
+    p0 = fake.sent[0][0]["params"]
+    assert p0["model"] == SONNET and p0["thinking"] == {"type": "adaptive"}
+    assert p0["max_tokens"] == 1000 and p0["messages"] == [{"role": "user", "content": "u0"}]
+    assert {r["custom_id"]: r["params"]["max_tokens"] for r in fake.sent[1]} == {
+        "r1": 1000,
+        "r3": 2000,
+    }
+    assert fake.sent[2][0]["params"]["model"] == "claude-opus-5"
+    assert fake.sent[2][0]["params"]["messages"][0]["content"] == "u2"
+    rows = [json.loads(line) for line in ledger.open()]
+    assert all(r["batch"] for r in rows) and len(rows) == 6
+    assert rows[0]["cost"] == pytest.approx((1000 * 2 + 100 * 10) / 1e6 / 2)
+    opus = [r for r in rows if r["model"] == "claude-opus-5"]
+    assert opus[0]["cost"] == pytest.approx((1000 * 5 + 100 * 25) / 1e6 / 2)
+    assert spend.refusals == 1 and fake.closed
+
+
+def test_batch_text_refusal_without_marker_is_none(batch_env, monkeypatch):
+    fake = FakeBatches([lambda reqs: [_ok("r0", _msg("", stop="refusal"))]])
+    got, served, _spend = _run_text(monkeypatch, fake, ["u0"])
+    assert got == {0: None} and served == {}
+    got, _s, _sp = _run_text(
+        monkeypatch,
+        FakeBatches([lambda reqs: [_ok("r0", _msg("", stop="refusal"))]]),
+        ["u0"],
+        mark_refusals=True,
+    )
+    assert got == {0: llm.REFUSED}
+
+
+def test_openrouter_setting_turns_batch_off(monkeypatch):
+    monkeypatch.setenv(llm.BATCH_ENV, "1")
+    monkeypatch.setenv(llm.VIA_OPENROUTER_ENV, "1")
+    assert not llm.batch_mode()
