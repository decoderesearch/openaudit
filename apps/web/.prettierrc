{
  "bracketSpacing": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "singleQuote": true,
  "plugins": ["prettier-plugin-organize-imports", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./app/globals.css",
  "overrides": [
    {
      "files": ["*.jsonc", "tsconfig*.json"],
      "options": { "trailingComma": "none" }
    }
  ]
}
