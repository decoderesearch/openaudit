# Committed defaults for local development against local Postgres. Loaded by every `pnpm` script
# through `scripts/with-env.js`. To develop against your Neon branch, set DATABASE_URL and
# DIRECT_URL in `.env.local` (gitignored), which overrides this file.
NEXT_PUBLIC_URL=http://localhost:3300
DATABASE_URL="postgres://postgres:postgres@localhost:5432/openaudit_dev"
DIRECT_URL="postgres://postgres:postgres@localhost:5432/openaudit_dev"
# Dev only. Production sets its own.
BETTER_AUTH_SECRET=dev-only-placeholder-set-your-own-in-env-local
BETTER_AUTH_URL=http://localhost:3300
# Empty: emails print to the server console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=OpenAudit <login@localhost>
BOOTSTRAP_ADMIN_EMAILS=
