# Every variable the app reads. Local defaults are in `.env.localhost`; put overrides and
# secrets in `.env.local` (gitignored). On Cloudflare, `wrangler.jsonc` has the vars; set secrets
# with `wrangler secret put`.

# Public URL of this deployment, no trailing slash.
NEXT_PUBLIC_URL=http://localhost:3300

# Neuronpedia, where "Open in J-Lens" posts a transcript. Default: https://www.neuronpedia.org.
# NEXT_PUBLIC_NEURONPEDIA_URL=http://localhost:3000

# Postgres. On Neon, DATABASE_URL is the pooled connection string and DIRECT_URL the direct one
# (migrations use it). Point them at your own branch (`dev-<name>`), never at prod. On Neon, use
# `sslmode=verify-full` (not `require`).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/openaudit_dev"
DIRECT_URL="postgres://postgres:postgres@localhost:5432/openaudit_dev"

# Better Auth. Generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3300

# Email. Leave RESEND_API_KEY empty to print emails to the server console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="OpenAudit <login@mail.openaudit.com>"
# Where replies to any email go. Default: support@openaudit.com.
REPLY_TO_ADDRESS=

# Sign-in abuse limits. Cloudflare Turnstile is on only when both keys are set. The site sends at
# most SIGN_IN_EMAILS_PER_DAY sign-in emails a day; at the cap it stops and alerts admins.
CLOUDFLARE_TURNSTILE_SITEKEY=
CLOUDFLARE_TURNSTILE_SECRETKEY=
SIGN_IN_EMAILS_PER_DAY=300

# Emails that become `admin` on first sign-in. Comma separated.
BOOTSTRAP_ADMIN_EMAILS=

# The site assistant (Ask OpenAudit, /api/ask). On only when OPENAUDIT_ASK is "1"; without the key
# it answers that it is not set up. ANTHROPIC_MODEL replaces the `site_assistant` model in
# spec/model-ladders.yaml. Questions per day: ASK_GLOBAL_DAILY for all readers together (default
# 2000), ASK_DAILY_PER_IP for one IP (default 100).
OPENAUDIT_ASK=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ASK_GLOBAL_DAILY=
ASK_DAILY_PER_IP=

# Cloudflare R2 for large files: saved copies of documents (scripts/mirror-documents.ts) and run
# logs. The bucket stays private; the app serves the files.
R2_ACCOUNT_ID=
R2_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=openaudit

# Hugging Face read token, for Hub lookups (`base_model:` tags) at import. Optional: without it,
# the Hub's lower anonymous rate limit applies.
HF_TOKEN=

# `pnpm db:refresh`: reset your Neon branch from prod. Needs `neonctl` auth or NEON_API_KEY.
# The project id is in Settings (`<word>-<word>-<digits>`), not the project name.
# /admin/sync (local only) copies eval runs to prod with NEON_PROJECT_ID and NEON_API_KEY.
NEON_PROJECT_ID=
NEON_API_KEY=
NEON_DEV_BRANCH=

# Eval runs. OPENAUDIT_RUNS=1 shows the Run button. Runs go to the Cloudflare queue RUN_QUEUE_ID,
# sent with CLOUDFLARE_RUN_QUEUE_WRITE_TOKEN (Queues write only). When a run ends, the runner
# calls /api/runner/notify with RUNNER_NOTIFY_TOKEN.
OPENAUDIT_RUNS=
RUN_QUEUE_ID=
CLOUDFLARE_RUN_QUEUE_WRITE_TOKEN=
RUNNER_NOTIFY_TOKEN=

# The sign-in form. Off unless "1".
OPENAUDIT_SIGN_IN=

# Error reports to Sentry. Off when SENTRY_DSN is not set. SENTRY_ENVIRONMENT: default "production".
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# The password gate (lib/site-gate.ts, Workers only). Off when SITE_PASSWORD is not set.
# `?unlock=<SITE_LINK_KEY>` on any page also opens it.
SITE_PASSWORD=
SITE_LINK_KEY=
