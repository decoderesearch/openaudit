# Committed. Layered over `.env.localhost` for tests (`with-env.mjs --test`). Tests only reach
# this throwaway database.
# `next dev` reads `.env.local` itself unless NODE_ENV is "test". This keeps the real Resend,
# Turnstile and Neon values out of the test server.
NODE_ENV=test
NEXT_PUBLIC_URL=http://localhost:3301
BETTER_AUTH_URL=http://localhost:3301
DATABASE_URL="postgres://postgres:postgres@localhost:5432/openaudit_test"
DIRECT_URL="postgres://postgres:postgres@localhost:5432/openaudit_test"
NEXT_DIST_DIR=.next-test
