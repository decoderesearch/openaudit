{
  "name": "@openaudit/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-env.mjs next dev -p 3300",
    "dev:prod": "node scripts/with-env.mjs node scripts/with-prod.mjs next dev -p 3310",
    "build": "prisma generate && prisma migrate deploy && next build",
    "build:app": "prisma generate && next build",
    "build:simple": "prisma generate && next build",
    "start": "node scripts/with-env.mjs next start -p 3300",
    "lint": "eslint --quiet . && tsc --noEmit",
    "lint:fix": "eslint --fix .",
    "format:write": "prettier --write \"**/*.{css,js,mjs,json,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{css,js,mjs,json,jsx,ts,tsx}\"",
    "test": "vitest run --project logic --project components",
    "test:watch": "vitest",
    "test:e2e": "node scripts/with-env.mjs --test playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "db:studio": "node scripts/with-env.mjs prisma studio",
    "db:refresh": "node scripts/with-env.mjs node scripts/db-refresh.mjs",
    "seed:import": "node scripts/with-env.mjs tsx scripts/import-seed.ts",
    "photos:commons": "tsx scripts/commons-photos.ts",
    "seed:import:test": "node scripts/with-env.mjs --test tsx scripts/import-seed.ts",
    "docs:mirror": "node scripts/with-env.mjs tsx scripts/mirror-documents.ts",
    "db:test:reset": "node scripts/with-env.mjs --test prisma migrate reset --force",
    "auth:generate": "node scripts/with-env.mjs auth generate --config lib/auth.ts --output prisma/better-auth.generated.prisma -y",
    "test:db": "node scripts/with-env.mjs --test vitest run --project db",
    "cf:build": "CF_WORKERS_BUILD=1 node scripts/with-env.mjs opennextjs-cloudflare build && node scripts/cf-strip-env.mjs",
    "cf:build:test": "CF_WORKERS_BUILD=1 node scripts/with-env.mjs --test opennextjs-cloudflare build && node scripts/cf-strip-env.mjs",
    "cf:preview:test": "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:postgres@localhost:5432/openaudit_test opennextjs-cloudflare preview --port 3301",
    "prices:baselines": "node scripts/with-env.mjs tsx scripts/price-baselines.ts",
    "routes:check": "tsx scripts/routes.ts",
    "runner:packages": "tsx scripts/runner-packages.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.67",
    "@ai-sdk/react": "^4.0.123",
    "@better-auth/api-key": "^1.7.6",
    "@openaudit/spec": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "11.16.0",
    "@tanstack/react-virtual": "^3.14.21",
    "ai": "^7.0.120",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.14.0",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "nextjs-toploader": "^3.9.17",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.30.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "auth": "1.7.6",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  },
  "imports": {
    "#prisma": "./lib/generated/prisma/client.ts"
  }
}
