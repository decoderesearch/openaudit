{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": [
    "uv",
    "uvx"
  ],
  "ignore": [
    "evals/**/.workspace-bench/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "data/scripts/*.mjs",
        "submissions/*.mjs"
      ]
    },
    "apps/web": {
      "entry": [
        "worker.ts",
        "open-next.config.ts",
        "scripts/*.{ts,mjs}",
        "instrumentation.ts",
        "lib/email/no-react-render.ts"
      ],
      "ignoreDependencies": [
        "auth",
        "postcss"
      ]
    },
    "spec": {
      "entry": [
        "scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "prettier",
        "quicktype"
      ]
    }
  }
}
