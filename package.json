{
  "name": "openaudit",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "pnpm --filter @openaudit/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test && node --test submissions/check.test.mjs submissions/check-eval.test.mjs submissions/check-harness.test.mjs submissions/leaderboards.test.mjs submissions/summary.test.mjs && uv run pytest -q",
    "test:db": "pnpm --filter @openaudit/web test:db",
    "test:e2e": "pnpm --filter @openaudit/web test:e2e",
    "spec:generate": "pnpm --filter @openaudit/spec-tools generate",
    "spec:check": "pnpm --filter @openaudit/spec-tools check"
  }
}
